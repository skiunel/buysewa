PORT=5000
NODE_ENV=development

# MongoDB - Local
# MONGODB_URI=mongodb://localhost:27017/buysewa_reviews

# MongoDB Atlas (cloud) - URL-encode special chars in password (e.g. @ -> %40, # -> %23)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/buysewa_reviews?appName=Cluster0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Redis (optional - falls back to in-memory store)
REDIS_URL=redis://localhost:6379

# Blockchain (Ganache)
GANACHE_URL=http://127.0.0.1:7545

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
